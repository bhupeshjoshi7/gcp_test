# =====================================================================
# SFTP Configuration
# =====================================================================
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=my_sftp_username

# Authentication: You can use either SFTP_PASSWORD or SFTP_KEY_PATH (or both)
SFTP_PASSWORD=my_sftp_password
SFTP_KEY_PATH=
SFTP_KEY_PASSPHRASE=

# Source File / Directory on SFTP Server
# Example single file: /exports/daily_report_20261010.csv
# Example directory for batch transfer: /exports/daily_feeds/
SFTP_REMOTE_PATH=/path/to/remote/file.csv

# =====================================================================
# Google Cloud Storage (GCS) Configuration
# =====================================================================
GCS_BUCKET_NAME=my-gcs-bucket-name

# Destination path / prefix inside the bucket (leave empty or "/" to save at bucket root)
# Example: incoming/reports/
GCS_DESTINATION_PREFIX=incoming/

# GCP Authentication:
# When running on GCP VM with attached Service Account, leave GOOGLE_APPLICATION_CREDENTIALS empty!
# (The Google Cloud Storage SDK automatically uses VM Application Default Credentials).
# If you are using a downloaded service account JSON key file, specify its path here:
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=

# =====================================================================
# Transfer Options
# =====================================================================
# Transfer Mode: 'stream' (memory-efficient direct pipe) or 'temp_file' (download to disk first, then upload)
TRANSFER_MODE=stream

# Delete source file from SFTP after successful upload to GCS (true / false)
DELETE_AFTER_UPLOAD=false

# Optional: Temporary directory if TRANSFER_MODE=temp_file (default: /tmp)
TEMP_DIR=/tmp
